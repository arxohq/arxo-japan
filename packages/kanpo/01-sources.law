    content_hash "sha256:30100dfe39802f7c786373c79f5e54f5a7d0db1acb1f8c06497a86a2f6ce2e24";
}

// --- 官報の発行に関する内閣府令（令和六年内閣府令第八十号） ---------------------------
// Pinned 15.09.2026: arts. 11–12 turn the art. 5(2) measure into a derived
// conclusion (10-promulgation.law); art. 10 (08:30 start, two exceptions) and
// art. 15 (inspection period with Act art. 8(1)) are modelled at day granularity.
// Window of the edition: 附則第一条 «この府令は、法の施行の日から施行する» — the day
// of the Act's enforcement, pinned as 2025-04-01 by 政令 309 (KANPO_SEIREI_309).

source KANPO_FUREI_80 {
    kind minister_order;
    jurisdiction JP;
    number "令和六年内閣府令第八十号";
    label ja official "官報の発行に関する内閣府令";
}


language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// Witness for `jp.constitution`: its sources.law pins the Constitution from
// https://elaws.e-gov.go.jp/api/1/lawdata/321CONSTITUTION (PINNED_UNOFFICIAL_COPY). That
// copy is a legislation-database record, not a record copied from 官報 under art. 5(5)
// or art. 10, so art. 12 does not make it 官報 — NEITHER, consistent with the declared
// unofficial status. The 1946 官報 promulgation itself predates the enforcement day
// and keeps its legal position (附則第三条; see test 07 for the same rule).
test "urn:query:kanpo-t08" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t08-a": issued_on(entity_ref("urn:jp:case:kanpo-1946-11-03"), @1946-11-03) { origin case_input; }
    }
    evaluate truth(counts_as_kanpo_for_other_laws(entity_ref("urn:jp:case:egov-321CONSTITUTION")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

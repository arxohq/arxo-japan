language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 第十二条: 第五条第五項により電磁的官報記録を複写した電磁的記録は、他の法令の官報の提供・送付の規定の適用上、官報に該当する。
test "urn:query:kanpo-t03" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t03-a": copied_from_kanpo_record(entity_ref("urn:jp:case:downloaded-record"), entity_ref("urn:jp:case:kanpo-2025-06-02")) { origin case_input; }
        assert "kanpo-t03-b": issued_on(entity_ref("urn:jp:case:kanpo-2025-06-02"), @2025-06-02) { origin case_input; }
    }
    evaluate truth(counts_as_kanpo_for_other_laws(entity_ref("urn:jp:case:downloaded-record")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

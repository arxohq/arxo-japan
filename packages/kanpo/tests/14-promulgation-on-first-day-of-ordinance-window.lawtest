language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令の版の窓（附則第一条: 法の施行の日＝令和七年四月一日）の初日: kanpo.go.jp への掲載から
// 措置が導かれ、その日に公布が行われる。
test "urn:query:kanpo-t14" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2025-04-01; decision_time @2025-04-01T12:00:00Z; knowledge_time @2025-04-01T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t14-a": recorded_in_kanpo_file(entity_ref("urn:jp:case:law-v"), entity_ref("urn:jp:case:kanpo-2025-04-01")) { origin case_input; }
        assert "kanpo-t14-b": issued_on(entity_ref("urn:jp:case:kanpo-2025-04-01"), @2025-04-01) { origin case_input; }
        assert "kanpo-t14-c": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-2025-04-01"), "https://www.kanpo.go.jp", @2025-04-01) { origin case_input; }
    }
    evaluate truth(promulgated_on(entity_ref("urn:jp:case:law-v"), @2025-04-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

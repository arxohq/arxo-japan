language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第二十四条第一項「書面官報の発行をした後に」: 書面官報の掲示（06-04）より前の掲載（06-03）は同項の措置ではない。
test "urn:query:kanpo-t43" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t43-01": issued_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t43"), @2025-06-04) { origin case_input; }
        assert "kanpo-t43-02": paper_kanpo_posted_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t43"), @2025-06-04) { origin case_input; }
        assert "kanpo-t43-03": paper_matters_posted_on_cabinet_office_website(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t43"), @2025-06-03) { origin case_input; }
    }
    evaluate truth(paper_matters_inspection_period_ends_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t43"), @2025-09-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第二十二条第二項括弧書: 措置 06-06（金）開始 → 翌日 06-07（土）休日, 06-08（日）休日 → 06-09（月）午前八時三十分まで。
test "urn:query:kanpo-t39" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t39-01": issued_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t39"), @2025-06-04) { origin case_input; }
        assert "kanpo-t39-02": paper_kanpo_posted_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t39"), @2025-06-04) { origin case_input; }
        assert "kanpo-t39-03": paper_matters_posted_on_cabinet_office_website(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t39"), @2025-06-06) { origin case_input; }
        assert "kanpo-t39-04": administrative_holiday(@2025-06-07) { origin case_input; }
        assert "kanpo-t39-05": administrative_holiday(@2025-06-08) { origin case_input; }
    }
    evaluate truth(paper_posting_period_ends_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t39"), @2025-06-09));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

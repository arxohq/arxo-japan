language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 法第八条第三項・内閣府令第十七条: 閲覧期間 2025-04-01〜2025-06-30 午前八時三十分; 十二時間以上の日 2 日（05-01 24 時間, 05-02 12 時間; 05-03 の 11 時間は算入しない）;
// 解消 05-03 は期間内 → 閲覧期間が経過した日 06-30 から起算して 2 日 → 07-02 午前八時三十分まで。
test "urn:query:kanpo-t22" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t22-01": issued_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d1"), @2025-04-01) { origin case_input; }
        assert "kanpo-t22-02": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-2025-04-01-d1"), "https://www.kanpo.go.jp", @2025-04-01) { origin case_input; }
        assert "kanpo-t22-03": disaster_or_unavoidable_circumstance(entity_ref("urn:jp:case:disruption-2025-05")) { origin case_input; }
        assert "kanpo-t22-04": measure_interrupted_by(entity_ref("urn:jp:case:kanpo-2025-04-01-d1"), entity_ref("urn:jp:case:disruption-2025-05")) { origin case_input; }
        assert "kanpo-t22-05": disruption_resolved_on(entity_ref("urn:jp:case:disruption-2025-05"), @2025-05-03) { origin case_input; }
        assert "kanpo-t22-06": unavailable_hours_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d1"), @2025-05-01, 24) { origin case_input; }
        assert "kanpo-t22-07": unavailable_hours_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d1"), @2025-05-02, 12) { origin case_input; }
        assert "kanpo-t22-08": unavailable_hours_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d1"), @2025-05-03, 11) { origin case_input; }
        assert "kanpo-t22-09": resolution_announced(entity_ref("urn:jp:case:disruption-2025-05")) { origin case_input; }
    }
    evaluate truth(additional_measure_ends_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d1"), @2025-07-02));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

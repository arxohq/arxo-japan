language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第十八条: いずれの号にも該当しないと判断された事項は引き続き閲覧に供される。
test "urn:query:kanpo-t29" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t29-01": issued_on(entity_ref("urn:jp:case:kanpo-2025-04-01-kanpo-t29"), @2025-04-01) { origin case_input; }
        assert "kanpo-t29-02": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-2025-04-01-kanpo-t29"), "https://www.kanpo.go.jp", @2025-04-01) { origin case_input; }
        assert "kanpo-t29-03": item_published_in(entity_ref("urn:jp:case:item-clear"), entity_ref("urn:jp:case:kanpo-2025-04-01-kanpo-t29")) { origin case_input; }
        assert "kanpo-t29-04": not concerns_act_toward_specific_addressee(entity_ref("urn:jp:case:item-clear")) { origin case_input; }
        assert "kanpo-t29-05": not indefinite_posting_risks_individual_privacy(entity_ref("urn:jp:case:item-clear")) { origin adjudicated; }
        assert "kanpo-t29-06": not indefinite_posting_specially_impeded(entity_ref("urn:jp:case:item-clear")) { origin adjudicated; }
    }
    evaluate truth(kept_available_after_inspection_period(entity_ref("urn:jp:case:item-clear")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect judgment_requests(0);
}

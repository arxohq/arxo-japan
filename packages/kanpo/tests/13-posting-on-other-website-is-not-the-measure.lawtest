language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第十一条・第十二条: 官報が https://www.kanpo.go.jp 以外のウェブサイト（ここでは国立印刷局の旧サイト）に
// 掲載されても、法第五条第二項の措置とは導かれず、第六条の公布の時点も導かれない。
test "urn:query:kanpo-t13" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t13-a": recorded_in_kanpo_file(entity_ref("urn:jp:case:law-w"), entity_ref("urn:jp:case:kanpo-2025-07-01")) { origin case_input; }
        assert "kanpo-t13-b": issued_on(entity_ref("urn:jp:case:kanpo-2025-07-01"), @2025-07-01) { origin case_input; }
        assert "kanpo-t13-c": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-2025-07-01"), "https://kanpou.npb.go.jp", @2025-07-01) { origin case_input; }
    }
    evaluate truth(promulgated_on(entity_ref("urn:jp:case:law-w"), @2025-07-01));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第二十二条第二項: 掲示 2025-06-04, 第二十四条第一項の措置を 06-05 に開始 → 開始日の翌日 06-06 午前八時三十分まで。
test "urn:query:kanpo-t37" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t37-01": issued_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t37"), @2025-06-04) { origin case_input; }
        assert "kanpo-t37-02": paper_kanpo_posted_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t37"), @2025-06-04) { origin case_input; }
        assert "kanpo-t37-03": paper_matters_posted_on_cabinet_office_website(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t37"), @2025-06-05) { origin case_input; }
    }
    evaluate truth(paper_posting_period_ends_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t37"), @2025-06-06));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第十八条第二号括弧書: 指定等法人に対する行為は第二号に当たらない — 第二号の判断は要求されない。
test "urn:query:kanpo-t34" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t34-01": issued_on(entity_ref("urn:jp:case:kanpo-2025-04-01-kanpo-t34"), @2025-04-01) { origin case_input; }
        assert "kanpo-t34-02": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-2025-04-01-kanpo-t34"), "https://www.kanpo.go.jp", @2025-04-01) { origin case_input; }
        assert "kanpo-t34-03": item_published_in(entity_ref("urn:jp:case:item-designated"), entity_ref("urn:jp:case:kanpo-2025-04-01-kanpo-t34")) { origin case_input; }
        assert "kanpo-t34-04": concerns_act_toward_specific_addressee(entity_ref("urn:jp:case:item-designated")) { origin case_input; }
        assert "kanpo-t34-05": addressee_is_designated_corporation(entity_ref("urn:jp:case:item-designated")) { origin case_input; }
        assert "kanpo-t34-06": not indefinite_posting_risks_individual_privacy(entity_ref("urn:jp:case:item-designated")) { origin adjudicated; }
        assert "kanpo-t34-07": not indefinite_posting_specially_impeded(entity_ref("urn:jp:case:item-designated")) { origin adjudicated; }
    }
    evaluate truth(kept_available_after_inspection_period(entity_ref("urn:jp:case:item-designated")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect judgment_requests(0);
}

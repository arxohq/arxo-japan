language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第二十四条第四項・第十八条第一号: プライバシーへの支障のおそれが認められた — 公益性の判断が残る。
test "urn:query:kanpo-t45" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t45-01": issued_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t45"), @2025-06-04) { origin case_input; }
        assert "kanpo-t45-02": paper_kanpo_posted_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t45"), @2025-06-04) { origin case_input; }
        assert "kanpo-t45-03": paper_matters_posted_on_cabinet_office_website(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t45"), @2025-06-05) { origin case_input; }
        assert "kanpo-t45-04": item_carried_in_paper_kanpo(entity_ref("urn:jp:case:paper-item-privacy"), entity_ref("urn:jp:case:shomen-kanpo-kanpo-t45")) { origin case_input; }
        assert "kanpo-t45-05": not concerns_act_toward_specific_addressee(entity_ref("urn:jp:case:paper-item-privacy")) { origin case_input; }
        assert "kanpo-t45-06": indefinite_posting_risks_individual_privacy(entity_ref("urn:jp:case:paper-item-privacy")) { origin adjudicated; }
        assert "kanpo-t45-07": not indefinite_posting_specially_impeded(entity_ref("urn:jp:case:paper-item-privacy")) { origin adjudicated; }
    }
    evaluate truth(paper_item_kept_available_after_period(entity_ref("urn:jp:case:paper-item-privacy")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(public_interest_particularly_high, PrimeMinisterOfJapan);
    expect judgment_requests(1);
}

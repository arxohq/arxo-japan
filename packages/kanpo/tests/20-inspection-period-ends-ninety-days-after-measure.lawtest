language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 法第八条第一項・内閣府令第十五条: 措置 2025-04-01（起算日）→ 九十日を経過した日 2025-06-30 の午前八時三十分まで。
test "urn:query:kanpo-t20" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t20-a": issued_on(entity_ref("urn:jp:case:kanpo-2025-04-01"), @2025-04-01) { origin case_input; }
        assert "kanpo-t20-b": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-2025-04-01"), "https://www.kanpo.go.jp", @2025-04-01) { origin case_input; }
    }
    evaluate truth(inspection_period_ends_on(entity_ref("urn:jp:case:kanpo-2025-04-01"), @2025-06-30));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

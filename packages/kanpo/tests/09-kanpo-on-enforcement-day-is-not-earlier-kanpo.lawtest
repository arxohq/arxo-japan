language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 附則第三条、境界の対（テスト07）: 施行日当日に発行された官報は「施行日前に発行された官報」ではない。
// Added after the mutation check: «施行日前» → «施行日以前» survived every earlier scenario.
test "urn:query:kanpo-t09" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t09-a": issued_on(entity_ref("urn:jp:case:kanpo-2025-04-01"), @2025-04-01) { origin case_input; }
    }
    evaluate truth(prior_legal_position_unaffected(entity_ref("urn:jp:case:kanpo-2025-04-01")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

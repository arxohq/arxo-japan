language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 法第八条第三項「前項の規定により災害等の事情が解消した旨の公表をしたときは」: 公表がなければ追加措置期間は生じない（テスト22と同じ事実、公表なし）。
test "urn:query:kanpo-t23" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t23-01": issued_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d2"), @2025-04-01) { origin case_input; }
        assert "kanpo-t23-02": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-2025-04-01-d2"), "https://www.kanpo.go.jp", @2025-04-01) { origin case_input; }
        assert "kanpo-t23-03": disaster_or_unavoidable_circumstance(entity_ref("urn:jp:case:disruption-2025-05b")) { origin case_input; }
        assert "kanpo-t23-04": measure_interrupted_by(entity_ref("urn:jp:case:kanpo-2025-04-01-d2"), entity_ref("urn:jp:case:disruption-2025-05b")) { origin case_input; }
        assert "kanpo-t23-05": disruption_resolved_on(entity_ref("urn:jp:case:disruption-2025-05b"), @2025-05-03) { origin case_input; }
        assert "kanpo-t23-06": unavailable_hours_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d2"), @2025-05-01, 24) { origin case_input; }
        assert "kanpo-t23-07": unavailable_hours_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d2"), @2025-05-02, 12) { origin case_input; }
        assert "kanpo-t23-08": unavailable_hours_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d2"), @2025-05-03, 11) { origin case_input; }
    }
    evaluate truth(additional_measure_ends_on(entity_ref("urn:jp:case:kanpo-2025-04-01-d2"), @2025-07-02));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

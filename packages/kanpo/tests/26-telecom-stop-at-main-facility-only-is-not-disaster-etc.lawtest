language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第十六条第二項「いずれもが…停止を受けたものに限る」: 自動公衆送信設備だけの停止は該当しない。
test "urn:query:kanpo-t26" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t26-01": telecom_service_stopped_at_main_facility(entity_ref("urn:jp:case:outage-2025-09")) { origin case_input; }
    }
    evaluate truth(disruption_is_disaster_etc(entity_ref("urn:jp:case:outage-2025-09")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 内閣府令第二十四条第一項〜第三項: 書面官報 2025-06-04, 内閣府のウェブサイトへの掲載 06-05 → 措置開始 06-05 → 起算して九十日を経過した日 09-03 午前八時三十分まで。
test "urn:query:kanpo-t42" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t42-01": issued_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t42"), @2025-06-04) { origin case_input; }
        assert "kanpo-t42-02": paper_kanpo_posted_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t42"), @2025-06-04) { origin case_input; }
        assert "kanpo-t42-03": paper_matters_posted_on_cabinet_office_website(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t42"), @2025-06-05) { origin case_input; }
    }
    evaluate truth(paper_matters_inspection_period_ends_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t42"), @2025-09-03));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

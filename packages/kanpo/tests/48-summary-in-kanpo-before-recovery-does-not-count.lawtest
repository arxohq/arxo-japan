language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 法第十一条第六項「できることとなった後に…発行する官報に」: 回復日 06-05 より前（06-04）に発行した官報への掲載は該当しない。
test "urn:query:kanpo-t48" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t48-01": issued_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t48"), @2025-06-04) { origin case_input; }
        assert "kanpo-t48-02": paper_kanpo_posted_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t48"), @2025-06-04) { origin case_input; }
        assert "kanpo-t48-03": measure_possible_again_on(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t48"), @2025-06-05) { origin case_input; }
        assert "kanpo-t48-04": issued_on(entity_ref("urn:jp:case:kanpo-kanpo-t48-after"), @2025-06-04) { origin case_input; }
        assert "kanpo-t48-05": made_available_for_inspection_at(entity_ref("urn:jp:case:kanpo-kanpo-t48-after"), "https://www.kanpo.go.jp", @2025-06-04) { origin case_input; }
        assert "kanpo-t48-06": carries_paper_kanpo_date_and_summary(entity_ref("urn:jp:case:kanpo-kanpo-t48-after"), entity_ref("urn:jp:case:shomen-kanpo-kanpo-t48")) { origin case_input; }
    }
    evaluate truth(paper_kanpo_summary_carried(entity_ref("urn:jp:case:shomen-kanpo-kanpo-t48")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

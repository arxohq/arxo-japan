language "law.core" version "0.2";
package jp.kanpo version "0.1.0";
namespace "urn:jp:corpus:clir:kanpo";

// 附則第二条、境界の対: 施行日の前日に発行された官報にはこの法律は適用されない。
test "urn:query:kanpo-t05" {
    given {
        context { deadline_policy KANPO_INSPECTION_PERIOD; legal_time @2026-09-15; decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; timezone "Asia/Tokyo"; }
        assert "kanpo-t05-a": issued_on(entity_ref("urn:jp:case:kanpo-2025-03-31"), @2025-03-31) { origin case_input; }
    }
    evaluate truth(act_applies_to(entity_ref("urn:jp:case:kanpo-2025-03-31")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

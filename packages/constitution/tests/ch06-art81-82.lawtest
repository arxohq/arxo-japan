    expect truth_status == TRUE_ONLY;
}

test "ART82-02-UNANIMOUS-FINDING-HEARING-NEED-NOT-BE-PUBLIC" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert court_hears(entity_ref("urn:jp:case:c1"), entity_ref("urn:jp:case:h1")) { id "f0"; origin case_input; }
        assert sits_on_bench(entity_ref("urn:jp:case:j0"), entity_ref("urn:jp:case:h1")) { id "f1"; origin case_input; }
        assert bench_judge_finds_danger(entity_ref("urn:jp:case:j0"), entity_ref("urn:jp:case:h1")) { id "f2"; origin adjudicated; }
        assert sits_on_bench(entity_ref("urn:jp:case:j1"), entity_ref("urn:jp:case:h1")) { id "f3"; origin case_input; }
        assert bench_judge_finds_danger(entity_ref("urn:jp:case:j1"), entity_ref("urn:jp:case:h1")) { id "f4"; origin adjudicated; }
        assert sits_on_bench(entity_ref("urn:jp:case:j2"), entity_ref("urn:jp:case:h1")) { id "f5"; origin case_input; }
        assert bench_judge_finds_danger(entity_ref("urn:jp:case:j2"), entity_ref("urn:jp:case:h1")) { id "f6"; origin adjudicated; }
    }
    evaluate truth(public_hearing_required(entity_ref("urn:jp:case:h1")));
    expect truth_status == FALSE_ONLY;
}


language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

// Chapter VI (stage J7). Historical context idiom: decision, knowledge and legal time on one date.
// Court decisions and classifications made by a court are facts with `origin adjudicated`;
// everything else is `case_input`.

test "ART81-01-UNANSWERED-JUDGMENT-REQUIRES-JUDGMENT" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert review_object_kind(entity_ref("urn:jp:case:a1"), statute) { id "f0"; origin case_input; }
    }
    evaluate truth(unconstitutionality_recognized(entity_ref("urn:jp:case:a1")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_requests(1);
    expect judgment_request(act_contradicts_constitution);
}

test "ART81-02-COURT-HOLDS-STATUTE-UNCONSTITUTIONAL-RECOGNIZED" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }

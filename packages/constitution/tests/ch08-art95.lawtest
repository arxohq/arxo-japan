        assert resident_of(entity_ref("urn:jp:case:res2"), entity_ref("urn:jp:case:c1")) { id "f8"; origin case_input; }
        assert votes_against(entity_ref("urn:jp:case:ref1"), entity_ref("urn:jp:case:res2")) { id "f9"; origin case_input; }
        assert resident_of(entity_ref("urn:jp:case:res3"), entity_ref("urn:jp:case:c1")) { id "f10"; origin case_input; }
        assert votes_against(entity_ref("urn:jp:case:ref1"), entity_ref("urn:jp:case:res3")) { id "f11"; origin case_input; }
        assert diet_enacts_special_law(entity_ref("urn:jp:case:l1")) { id "f12"; origin case_input; }
    }
    evaluate truth(special_law_enacted(entity_ref("urn:jp:case:l1")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}


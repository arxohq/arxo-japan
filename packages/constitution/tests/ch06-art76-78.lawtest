    }
    evaluate truth(holds_judicial_power(entity_ref("urn:jp:case:o1")));
    expect truth_status == NEITHER;
}

test "ART76-05-EXTRAORDINARY-TRIBUNAL-ESTABLISHED-VIOLATES-PROHIBITION" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f0"; origin case_input; }
        assert tribunal(entity_ref("urn:jp:case:t1")) { id "f1"; origin case_input; }
        assert establishes_tribunal(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:t1")) { id "f2"; origin case_input; }
        assert is_extraordinary_tribunal(entity_ref("urn:jp:case:t1")) { id "f3"; origin adjudicated; }
    }
    evaluate positions();
    expect position(NoExtraordinaryTribunal, VIOLATED);
}

test "ART76-06-ORDINARY-TRIBUNAL-NOT-A-VIOLATION" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f0"; origin case_input; }
        assert tribunal(entity_ref("urn:jp:case:t1")) { id "f1"; origin case_input; }
        assert establishes_tribunal(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:t1")) { id "f2"; origin case_input; }
        assert not is_extraordinary_tribunal(entity_ref("urn:jp:case:t1")) { id "f3"; origin adjudicated; }
    }
    evaluate positions();
    expect not position(NoExtraordinaryTribunal, VIOLATED);
    expect position(NoExtraordinaryTribunal, ACTIVE);
}

test "ART76-07-NO-TRIBUNAL-ESTABLISHED-PROHIBITION-ACTIVE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }

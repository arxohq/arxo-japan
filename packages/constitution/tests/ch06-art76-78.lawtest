language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

// Chapter VI (stage J7). Historical context idiom: decision, knowledge and legal time on one date.
// Court decisions and classifications made by a court are facts with `origin adjudicated`;
// everything else is `case_input`.

test "ART76-01-SUPREME-COURT-HOLDS-JUDICIAL-POWER" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
    }
    evaluate truth(holds_judicial_power(SupremeCourtOfJapan));
    expect truth_status == TRUE_ONLY;
}

test "ART76-02-LOWER-COURT-ESTABLISHED-BY-STATUTE-HOLDS-JUDICIAL-POWER" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert inferior_court(entity_ref("urn:jp:case:c1")) { id "f0"; origin case_input; }
        assert established_under_statute(entity_ref("urn:jp:case:c1")) { id "f1"; origin case_input; }
    }
    evaluate truth(holds_judicial_power(entity_ref("urn:jp:case:c1")));
    expect truth_status == TRUE_ONLY;
}

test "ART76-03-LOWER-COURT-WITHOUT-STATUTE-NO-JUDICIAL-POWER" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert inferior_court(entity_ref("urn:jp:case:c1")) { id "f0"; origin case_input; }
    }
    evaluate truth(holds_judicial_power(entity_ref("urn:jp:case:c1")));
    expect truth_status == NEITHER;
}

test "ART76-04-EXECUTIVE-ORGAN-HOLDS-NO-JUDICIAL-POWER" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert j7_executive_organ(entity_ref("urn:jp:case:o1")) { id "f0"; origin case_input; }

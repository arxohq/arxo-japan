        assert inferior_court(entity_ref("urn:jp:case:c1")) { id "f1"; origin case_input; }
        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f2"; origin case_input; }
        assert j7_executive_organ(entity_ref("urn:jp:case:o2")) { id "f3"; origin case_input; }

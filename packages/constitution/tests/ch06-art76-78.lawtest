    }
    evaluate positions();
    expect position(NoExtraordinaryTribunal, ACTIVE);
    expect not position(NoExtraordinaryTribunal, VIOLATED);
}

test "ART76-08-UNANSWERED-CLASSIFICATION-REQUIRES-JUDGMENT" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }

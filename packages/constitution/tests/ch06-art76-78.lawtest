        assert establishes_tribunal(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:t1")) { id "f2"; origin case_input; }
    }
    evaluate truth(establishes_extraordinary_tribunal(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:t1")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(is_extraordinary_tribunal);
}


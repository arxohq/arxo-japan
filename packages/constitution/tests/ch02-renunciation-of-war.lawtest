test "JC9-11-MAINTAINING-WAR-POTENTIAL-IS-VIOLATED" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "Asia/Tokyo";
            interpretation LiteralPacifistReading;
        }

        assert "assert-f0": land_sea_or_air_force(entity_ref("urn:jp:case:force:1")) {
            origin case_input;
        }

        assert "assert-f1": maintains_force(Japan, entity_ref("urn:jp:case:force:1")) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info);
    expect position(MaintainWarPotential, VIOLATED);
    expect not position(MaintainWarPotential, ACTIVE);
}

test "JC9-10-BEFORE-COMMENCEMENT-IS-PENDING" {
    given {
        context {
            decision_time @1947-05-02T12:00:00Z;
            knowledge_time @1947-05-02T12:00:00Z;
            legal_time @1947-05-02;
            timezone "Asia/Tokyo";
        }
    }

    evaluate positions();
    expect issues_within(info);
    expect position(BelligerentStatusInvocation, PENDING);
    expect position(ThreatOrUseOfForceToSettleDispute, PENDING);
    expect position(WarAsSovereignRight, PENDING);
}

// Errata E-0179: the prohibitions stand ACTIVE while the act is not established.
test "JC9-12-NO-ACT-ESTABLISHED-PROHIBITIONS-STAND-ACTIVE" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "Asia/Tokyo";
        }
    }

    evaluate positions();
    expect issues_within(info);
    expect position(WarAsSovereignRight, ACTIVE);
    expect position(ThreatOrUseOfForceToSettleDispute, ACTIVE);
    expect position(BelligerentStatusInvocation, ACTIVE);
    expect not position(WarAsSovereignRight, VIOLATED);
    expect not position(ThreatOrUseOfForceToSettleDispute, VIOLATED);
    expect not position(BelligerentStatusInvocation, VIOLATED);
}


test "JC9-04-NECESSARY-MINIMUM-REQUIRES-JUDGMENT" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "Asia/Tokyo";
        }

        assert "assert-f0": land_sea_or_air_force(entity_ref("urn:jp:case:force:1")) {
            origin case_input;
        }
    }

    evaluate truth(force_exceeds_necessary_minimum_established(entity_ref("urn:jp:case:force:1")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect issues_within(info);
    expect judgment_requests(1);
    expect judgment_request(exceeds_necessary_minimum_for_self_defense);
}

test "JC9-05-NECESSARY-MINIMUM-ESTABLISHED-BY-CASE" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "Asia/Tokyo";
        }

        assert "assert-f0": land_sea_or_air_force(entity_ref("urn:jp:case:force:1")) {
            origin case_input;
        }

        assert "assert-f1": exceeds_necessary_minimum_for_self_defense(entity_ref("urn:jp:case:force:1")) {
            origin case_input;
        }
    }

    evaluate truth(force_exceeds_necessary_minimum_established(entity_ref("urn:jp:case:force:1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}


language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

// Scenarios moved from the former Python runner of the family
// the retired family of Article 9. Titles keep the former scenario IDs; expectations
// derive from the FORMER checks, not from engine answers.

test "JC9-01-WAR-AS-SOVEREIGN-RIGHT-IS-VIOLATED" {
    given {
        context {
            decision_time @2026-01-01T12:00:00Z;
            knowledge_time @2026-01-01T12:00:00Z;
            legal_time @2026-01-01;
            timezone "Asia/Tokyo";
        }

        assert "assert-f0": wages_war(Japan) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info);
    expect position(WarAsSovereignRight, VIOLATED);
    expect not position(WarAsSovereignRight, ACTIVE);
}


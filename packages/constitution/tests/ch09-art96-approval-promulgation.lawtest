        assert votes_against(entity_ref("urn:jp:case:ref1"), entity_ref("urn:jp:case:ref1v4")) { id "f49"; origin case_input; }
        assert act_kind(entity_ref("urn:jp:case:a1"), promulgate_amendment) { id "f50"; origin case_input; }
        assert performs_act(Emperor, entity_ref("urn:jp:case:a1")) { id "f51"; origin case_input; }
        assert cabinet_advised_and_approved(entity_ref("urn:jp:case:a1")) { id "f52"; origin case_input; }
        assert promulgation_act_of(entity_ref("urn:jp:case:a1"), entity_ref("urn:jp:case:x1")) { id "f53"; origin case_input; }
        assert promulgated_in_name_of_people(entity_ref("urn:jp:case:a1")) { id "f54"; origin case_input; }
        assert promulgated_as_integral_part(entity_ref("urn:jp:case:a1")) { id "f55"; origin case_input; }
        assert not amendment_promulgated_immediately(entity_ref("urn:jp:case:x1")) { id "f56"; origin adjudicated; }
    }
    evaluate positions();
    expect not position(PromulgateAmendmentDuty, VIOLATED);
    expect position(PromulgateAmendmentImmediatelyDuty, VIOLATED);
}


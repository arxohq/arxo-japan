        assert exercise_by(entity_ref("urn:jp:case:x1"), entity_ref("urn:jp:case:p1")) { id "f2"; origin case_input; }
    }
    evaluate truth(abusive_exercise(entity_ref("urn:jp:case:p1"), entity_ref("urn:jp:case:x1")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(exercise_contradicts_public_welfare);
}


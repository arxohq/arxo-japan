test "ART11-03-IMMUNITY-ACTIVE-FOR-NATIONAL" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert nationality_statute(entity_ref("urn:jp:case:l1")) { id "f0"; origin case_input; }
        assert meets_statutory_nationality_requirements(entity_ref("urn:jp:case:p1"), entity_ref("urn:jp:case:l1")) { id "f1"; origin case_input; }
        assert limitation_affects(entity_ref("urn:jp:case:r1"), entity_ref("urn:jp:case:p1")) { id "f2"; origin case_input; }
        assert limitation_of_exercise(entity_ref("urn:jp:case:r1"), entity_ref("urn:jp:case:x1")) { id "f3"; origin case_input; }
        assert exercise_by(entity_ref("urn:jp:case:x1"), entity_ref("urn:jp:case:p1")) { id "f4"; origin case_input; }
        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(FundamentalRightsInviolable, ACTIVE);
}

test "ART11-04-NO-IMMUNITY-FOR-NON-NATIONAL" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert limitation_affects(entity_ref("urn:jp:case:r1"), entity_ref("urn:jp:case:p1")) { id "f0"; origin case_input; }
        assert nationality_statute(entity_ref("urn:jp:case:l1")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect not position(FundamentalRightsInviolable, ACTIVE);
}


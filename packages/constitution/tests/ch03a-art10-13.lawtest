        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f2"; origin case_input; }
        assert disregards_individual(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:p1")) { id "f3"; origin case_input; }
    }

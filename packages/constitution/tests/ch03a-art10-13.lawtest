    expect position(NoAbuseOfFreedomsAndRights, ACTIVE);
    expect not position(NoAbuseOfFreedomsAndRights, VIOLATED);
}

test "ART12-03-ABUSE-REQUIRES-JUDGMENT-WITHOUT-COURT-ANSWER" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }

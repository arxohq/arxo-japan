language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

// Chapter III part 1 (Arts. 10-24), stage J3. Historical context idiom: decision, knowledge and legal time
// on one date. Court decisions are facts with `origin adjudicated`; everything else is `case_input`.
test "ART10-01-STATUTORY-REQUIREMENTS-MET-PERSON-IS-NATIONAL" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert nationality_statute(entity_ref("urn:jp:case:l1")) { id "f0"; origin case_input; }
        assert meets_statutory_nationality_requirements(entity_ref("urn:jp:case:p1"), entity_ref("urn:jp:case:l1")) { id "f1"; origin case_input; }
    }
    evaluate truth(r3a_national(entity_ref("urn:jp:case:p1")));
    expect truth_status == TRUE_ONLY;
}

test "ART10-02-REQUIREMENTS-WITHOUT-NATIONALITY-STATUTE-NO-STATUS" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert meets_statutory_nationality_requirements(entity_ref("urn:jp:case:p1"), entity_ref("urn:jp:case:l1")) { id "f0"; origin case_input; }
    }
    evaluate truth(r3a_national(entity_ref("urn:jp:case:p1")));
    expect truth_status == NEITHER;
}


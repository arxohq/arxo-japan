    expect position(RespectIndividual, VIOLATED);
}

test "ART13-03-UTMOST-RESPECT-DUTY-ACTIVE-WHEN-NOT-CONTRARY" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert nationality_statute(entity_ref("urn:jp:case:l1")) { id "f0"; origin case_input; }
        assert meets_statutory_nationality_requirements(entity_ref("urn:jp:case:p1"), entity_ref("urn:jp:case:l1")) { id "f1"; origin case_input; }
        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f2"; origin case_input; }
        assert exercise_by(entity_ref("urn:jp:case:x1"), entity_ref("urn:jp:case:p1")) { id "f3"; origin case_input; }
        assert exercise_kind(entity_ref("urn:jp:case:x1"), life_liberty_pursuit) { id "f4"; origin case_input; }
        assert not exercise_contradicts_public_welfare(entity_ref("urn:jp:case:x1")) { id "f5"; origin adjudicated; }
    }
    evaluate positions();
    expect position(UtmostRespectForLifeLibertyHappiness, ACTIVE);
}


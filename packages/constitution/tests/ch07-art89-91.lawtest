test "ART91-22-AN-ASSERTED-ABSENCE-OF-THE-NEXT-REPORT-AFTER-THE-YEAR-VIOLATES-THE-DUTY" {
    given {
        context { decision_time @2027-03-16T12:00:00Z; knowledge_time @2027-03-16T12:00:00Z; legal_time @2027-03-16; timezone "Asia/Tokyo"; deadline_policy DIET_CALENDAR_STEP; }

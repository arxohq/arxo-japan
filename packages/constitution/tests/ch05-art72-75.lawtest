        context { decision_time @2026-04-10T12:00:00Z; knowledge_time @2026-04-10T12:00:00Z; legal_time @2026-04-10; timezone "Asia/Tokyo"; }
        assert prosecuting_authority(entity_ref("urn:jp:case:PA")) { id "f0"; origin case_input; }
        assert prosecutable_person(entity_ref("urn:jp:case:M1")) { id "f1"; origin case_input; }
        assert state_minister(entity_ref("urn:jp:case:M1")) { id "f2"; origin case_input; }
        assert prosecution_authorised_by_law(entity_ref("urn:jp:case:M1")) { id "f3"; origin case_input; }
        assert prosecutes(entity_ref("urn:jp:case:PA"), entity_ref("urn:jp:case:M1")) { id "f4"; origin case_input; }
    }
    evaluate truth(prosecution_takes_effect(entity_ref("urn:jp:case:M1")));
    expect truth_status == NEITHER;
    expect issue(EFFECT_BLOCKED_BY_IMMUNITY);
}


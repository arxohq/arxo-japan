test "ART2-01-SUCCESSION-BY-DIET-ADOPTED-HOUSE-LAW" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert in_hereditary_line(entity_ref("urn:jp:constitution:clir#P1")) { id "f0"; origin case_input; }
        assert succession_defined_by(entity_ref("urn:jp:constitution:clir#P1"), entity_ref("urn:jp:constitution:clir#L1")) { id "f1"; origin case_input; }
        assert imperial_house_law(entity_ref("urn:jp:constitution:clir#L1")) { id "f2"; origin case_input; }
        assert adopted_by_diet_resolution(entity_ref("urn:jp:constitution:clir#L1")) { id "f3"; origin case_input; }
    }
    evaluate truth(succeeds_to_throne(entity_ref("urn:jp:constitution:clir#P1")));
    expect truth_status == TRUE_ONLY;
}


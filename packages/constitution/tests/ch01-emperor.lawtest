        assert party_to_transfer(entity_ref("urn:jp:constitution:clir#P1"), entity_ref("urn:jp:constitution:clir#T1")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(ImperialHouseTransferWithoutDietResolution, ACTIVE);
    expect not position(ImperialHouseTransferWithoutDietResolution, VIOLATED);
}

test "ART8-04-TRANSFER-BEFORE-ENTRY-INTO-FORCE-NOT-VIOLATED" {
    given {
        context { decision_time @1947-05-02T12:00:00Z; knowledge_time @1947-05-02T12:00:00Z; legal_time @1947-05-02; timezone "Asia/Tokyo"; }
        assert imperial_house_transfer(entity_ref("urn:jp:constitution:clir#T1")) { id "f0"; origin case_input; }
        assert party_to_transfer(entity_ref("urn:jp:constitution:clir#P1"), entity_ref("urn:jp:constitution:clir#T1")) { id "f1"; origin case_input; }
        assert performs_transfer(entity_ref("urn:jp:constitution:clir#P1"), entity_ref("urn:jp:constitution:clir#T1")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect not position(ImperialHouseTransferWithoutDietResolution, VIOLATED);
}

        assert act_kind(entity_ref("urn:jp:constitution:clir#A1"), promulgate_law) { id "f1"; origin case_input; }
        assert cabinet_advised_and_approved(entity_ref("urn:jp:constitution:clir#A1")) { id "f2"; origin case_input; }
        assert performs_act(Emperor, entity_ref("urn:jp:constitution:clir#A1")) { id "f3"; origin case_input; }
    }
    evaluate truth(act_has_legal_effect(entity_ref("urn:jp:constitution:clir#A1")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}


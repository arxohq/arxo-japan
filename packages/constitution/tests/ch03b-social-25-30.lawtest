language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

test "ART25-01-NATIONAL-HOLDS-RIGHT-TO-MINIMUM-LIFE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3b_national(entity_ref("urn:jp:case:p1")) { id "f0"; origin case_input; }
    }
    evaluate truth(right_to_minimum_life(entity_ref("urn:jp:case:p1")));
    expect truth_status == TRUE_ONLY;
}

test "ART25-02-NON-NATIONAL-HAS-NO-RIGHT-BY-THIS-RULE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3b_person(entity_ref("urn:jp:case:p1")) { id "f0"; origin case_input; }
    }
    evaluate truth(right_to_minimum_life(entity_ref("urn:jp:case:p1")));
    expect truth_status == NEITHER;
}


test "ART29-01-TAKING-FOR-PUBLIC-USE-WITH-JUST-COMPENSATION-EFFECTIVE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3b_authority(entity_ref("urn:jp:case:o1")) { id "f0"; origin case_input; }
        assert property_taking_of(entity_ref("urn:jp:case:t1"), entity_ref("urn:jp:case:p1")) { id "f1"; origin case_input; }
        assert takes_property(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:t1")) { id "f2"; origin case_input; }
        assert taking_for_public_use(entity_ref("urn:jp:case:t1")) { id "f3"; origin adjudicated; }
        assert compensation_is_just(entity_ref("urn:jp:case:t1")) { id "f4"; origin adjudicated; }
    }

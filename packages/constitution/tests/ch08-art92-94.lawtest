        assert ordinance_of(entity_ref("urn:jp:case:ord1"), entity_ref("urn:jp:case:c1")) { id "f1"; origin case_input; }
        assert local_body_enacts_ordinance(entity_ref("urn:jp:case:c1"), entity_ref("urn:jp:case:ord1")) { id "f2"; origin case_input; }
        assert ordinance_within_range_of_law(entity_ref("urn:jp:case:ord1")) { id "f3"; origin adjudicated; }
    }
    evaluate truth(ordinance_in_force(entity_ref("urn:jp:case:ord1")));
    expect truth_status == TRUE_ONLY;
}

test "ART94-07-AN-ORDINANCE-OUTSIDE-THE-RANGE-OF-THE-LAW-IS-AN-INVALID-EXERCISE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; deadline_policy DIET_CALENDAR_STEP; }

test "ART79-05-CABINET-APPOINTS-JUSTICE-BELOW-STATUTORY-NUMBER" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert j7_cabinet(entity_ref("urn:jp:case:o1")) { id "f0"; origin case_input; }
        assert justice_candidate(entity_ref("urn:jp:case:p1")) { id "f1"; origin case_input; }
        assert statutory_number_of_other_justices(3) { id "f2"; origin case_input; }
        assert sitting_other_justice(entity_ref("urn:jp:case:s0")) { id "f3"; origin case_input; }
        assert sitting_other_justice(entity_ref("urn:jp:case:s1")) { id "f4"; origin case_input; }
        assert cabinet_appoints_justice(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:p1")) { id "f5"; origin case_input; }
    }
    evaluate truth(appointed_justice_by_cabinet(entity_ref("urn:jp:case:p1")));
    expect truth_status == TRUE_ONLY;
}


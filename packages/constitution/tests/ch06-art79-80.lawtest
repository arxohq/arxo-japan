language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

// Chapter VI (stage J7). Historical context idiom: decision, knowledge and legal time on one date.
// Court decisions and classifications made by a court are facts with `origin adjudicated`;
// everything else is `case_input`.

test "ART79-01-CHIEF-JUSTICE-APPOINTED-BY-EMPEROR-ON-CABINET-DESIGNATION" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert state_matter_act(entity_ref("urn:jp:case:a1")) { id "f0"; origin case_input; }
        assert act_kind(entity_ref("urn:jp:case:a1"), appoint_chief_justice) { id "f1"; origin case_input; }
        assert performs_act(Emperor, entity_ref("urn:jp:case:a1")) { id "f2"; origin case_input; }
        assert act_appoints_person(entity_ref("urn:jp:case:a1"), entity_ref("urn:jp:case:p1")) { id "f3"; origin case_input; }
        assert designated_by_cabinet(entity_ref("urn:jp:case:a1")) { id "f4"; origin case_input; }
        assert cabinet_advised_and_approved(entity_ref("urn:jp:case:a1")) { id "f5"; origin case_input; }
    }
    evaluate truth(chief_justice(entity_ref("urn:jp:case:p1")));
    expect truth_status == TRUE_ONLY;
}


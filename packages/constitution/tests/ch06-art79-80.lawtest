test "ART79-13-FIRST-REVIEW-AT-FIRST-GENERAL-ELECTION-AFTER-APPOINTMENT" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; deadline_policy J7_ANNIVERSARY; }
        assert holds_judicial_office(entity_ref("urn:jp:case:p1"), SupremeCourtOfJapan) { id "f0"; origin case_input; }
        assert appointed_on(entity_ref("urn:jp:case:p1"), @2015-03-01) { id "f1"; origin case_input; }
        assert house_general_election_on(@2017-10-22) { id "f2"; origin case_input; }
        assert house_general_election_on(@2021-10-31) { id "f3"; origin case_input; }
        assert house_general_election_on(@2024-10-27) { id "f4"; origin case_input; }
    }
    evaluate truth(review_due_on(entity_ref("urn:jp:case:p1"), @2017-10-22));
    expect truth_status == TRUE_ONLY;
}


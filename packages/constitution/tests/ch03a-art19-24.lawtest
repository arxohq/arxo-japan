language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

// Chapter III part 1 (Arts. 10-24), stage J3. Historical context idiom: decision, knowledge and legal time
// on one date. Court decisions are facts with `origin adjudicated`; everything else is `case_input`.
test "ART19-01-THOUGHT-AND-CONSCIENCE-LIBERTY" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert person_present(entity_ref("urn:jp:case:p1")) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(ThoughtAndConscience, ACTIVE);
}

test "ART19-02-INFRINGEMENT-VIOLATES-PROHIBITION" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f0"; origin case_input; }
        assert person_present(entity_ref("urn:jp:case:p1")) { id "f1"; origin case_input; }
        assert infringes_thought_or_conscience(entity_ref("urn:jp:case:o1"), entity_ref("urn:jp:case:p1")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(NoInfringementOfConscience, VIOLATED);
}

test "ART19-03-NO-INFRINGEMENT-PROHIBITION-ACTIVE" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3a_state_organ(entity_ref("urn:jp:case:o1")) { id "f0"; origin case_input; }
        assert person_present(entity_ref("urn:jp:case:p1")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(NoInfringementOfConscience, ACTIVE);
    expect not position(NoInfringementOfConscience, VIOLATED);
}

test "ART19-04-NO-ORGAN-NO-PROHIBITION" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }

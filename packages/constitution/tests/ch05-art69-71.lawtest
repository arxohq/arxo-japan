test "ART71-18-A-VALID-APPOINTMENT-OF-THE-PRIME-MINISTER-IS-DATED" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; deadline_policy DIET_CALENDAR_STEP; }
        assert state_matter_act(entity_ref("urn:jp:case:A1")) { id "f0"; origin case_input; }
        assert act_kind(entity_ref("urn:jp:case:A1"), appoint_prime_minister) { id "f1"; origin case_input; }
        assert performs_act(Emperor, entity_ref("urn:jp:case:A1")) { id "f2"; origin case_input; }
        assert state_act_dated(entity_ref("urn:jp:case:A1"), @2026-04-10) { id "f3"; origin case_input; }
        assert cabinet_advised_and_approved(entity_ref("urn:jp:case:A1")) { id "f4"; origin case_input; }
        assert designated_by_diet(entity_ref("urn:jp:case:A1")) { id "f5"; origin case_input; }
    }
    evaluate truth(pm_appointed_on(@2026-04-10));
    expect truth_status == TRUE_ONLY;
}


test "ART88-12-WITHOUT-A-FISCAL-YEAR-THE-DUTY-DOES-NOT-ARISE" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "Asia/Tokyo"; deadline_policy DIET_CALENDAR_STEP; }

        assert present_at(entity_ref("urn:jp:case:m_b1_0"), entity_ref("urn:jp:case:vp0")) { id "f7"; origin case_input; }
        assert votes_for(entity_ref("urn:jp:case:m_b1_0"), entity_ref("urn:jp:case:vp0")) { id "f8"; origin case_input; }
        assert vote_on_proposal(entity_ref("urn:jp:case:m_b1_0"), entity_ref("urn:jp:case:b1")) { id "f9"; origin case_input; }

test "ART88-10-EXPENSE-NOT-BUDGETED-AFTER-THE-YEAR-IS-NOT-A-VIOLATION-BY-SILENCE" {
    given {
        context { decision_time @2027-04-01T12:00:00Z; knowledge_time @2027-04-01T12:00:00Z; legal_time @2027-04-01; timezone "Asia/Tokyo"; deadline_policy DIET_CALENDAR_STEP; }
        assert fiscal_year_span(entity_ref("urn:jp:case:fy1"), @2026-04-01, @2027-03-31) { id "f0"; origin case_input; }
        assert fiscal_year_span(entity_ref("urn:jp:case:fy2"), @2027-04-01, @2028-03-31) { id "f1"; origin case_input; }
        assert following_fiscal_year(entity_ref("urn:jp:case:fy1"), entity_ref("urn:jp:case:fy2")) { id "f2"; origin case_input; }
        assert imperial_house_expense_of_year(entity_ref("urn:jp:case:e1"), entity_ref("urn:jp:case:fy1")) { id "f3"; origin case_input; }
        assert budget_for_year(entity_ref("urn:jp:case:b1"), entity_ref("urn:jp:case:fy1")) { id "f4"; origin case_input; }
        assert proposal_kind(entity_ref("urn:jp:case:b1"), pk_budget) { id "f5"; origin case_input; }
        assert proposal_before_diet(entity_ref("urn:jp:case:b1")) { id "f6"; origin case_input; }
        assert motion_before(entity_ref("urn:jp:case:m_b1_0"), HouseOfRepresentatives) { id "f7"; origin case_input; }
        assert put_to_vote(entity_ref("urn:jp:case:m_b1_0")) { id "f8"; origin case_input; }
        assert member_count(HouseOfRepresentatives, 3) { id "f9"; origin case_input; }
        assert present_at(entity_ref("urn:jp:case:m_b1_0"), entity_ref("urn:jp:case:vp0")) { id "f10"; origin case_input; }
        assert votes_for(entity_ref("urn:jp:case:m_b1_0"), entity_ref("urn:jp:case:vp0")) { id "f11"; origin case_input; }
        assert vote_on_proposal(entity_ref("urn:jp:case:m_b1_0"), entity_ref("urn:jp:case:b1")) { id "f12"; origin case_input; }
        assert motion_before(entity_ref("urn:jp:case:m_b1_1"), HouseOfCouncillors) { id "f13"; origin case_input; }
        assert put_to_vote(entity_ref("urn:jp:case:m_b1_1")) { id "f14"; origin case_input; }
        assert member_count(HouseOfCouncillors, 3) { id "f15"; origin case_input; }
        assert present_at(entity_ref("urn:jp:case:m_b1_1"), entity_ref("urn:jp:case:vp1")) { id "f16"; origin case_input; }
        assert votes_for(entity_ref("urn:jp:case:m_b1_1"), entity_ref("urn:jp:case:vp1")) { id "f17"; origin case_input; }
        assert vote_on_proposal(entity_ref("urn:jp:case:m_b1_1"), entity_ref("urn:jp:case:b1")) { id "f18"; origin case_input; }
    }
    evaluate positions();
    expect position(CabinetBudgetsImperialExpense, UNDETERMINED);
    expect not position(CabinetBudgetsImperialExpense, VIOLATED);
}


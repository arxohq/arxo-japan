        assert relates_to_government(entity_ref("urn:jp:case:i1")) { id "f1"; origin case_input; }
        assert witness_summoned(entity_ref("urn:jp:case:w1"), entity_ref("urn:jp:case:i1")) { id "f2"; origin case_input; }
        assert documents_sought(entity_ref("urn:jp:case:d1"), entity_ref("urn:jp:case:i1")) { id "f3"; origin case_input; }
        assert house_conducts_investigation(HouseOfRepresentatives, entity_ref("urn:jp:case:i1")) { id "f4"; origin case_input; }
    }
    evaluate truth(investigation_authorised(entity_ref("urn:jp:case:i1")));
    expect truth_status == TRUE_ONLY;
}


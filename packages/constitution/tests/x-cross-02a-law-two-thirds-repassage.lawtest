        assert revote_on_proposal(entity_ref("urn:jp:case:M3"), entity_ref("urn:jp:case:L1")) { id "f66"; origin case_input; }
        assert special_procedure_applies(entity_ref("urn:jp:case:L1")) { id "f67"; origin case_input; }
    }
    evaluate truth(enacted_as_law(entity_ref("urn:jp:case:L1")));
    expect truth_status == NEITHER;
}


        assert convicts_and_sentences(entity_ref("urn:jp:case:o2"), entity_ref("urn:jp:case:c1")) { id "f16"; origin case_input; }
        assert procedure_established_by_law_followed(entity_ref("urn:jp:case:c1")) { id "f17"; origin case_input; }
        assert not detention_unduly_prolonged(entity_ref("urn:jp:case:d1")) { id "f18"; origin adjudicated; }
    }
    evaluate truth(criminal_liability_imposed(entity_ref("urn:jp:case:c1")));
    expect truth_status == NEITHER;
    expect issue(EFFECT_BLOCKED_BY_IMMUNITY);
}


language "law.core" version "0.2";
package jp.constitution version "0.1.0";
namespace "urn:jp:constitution:clir";

test "ART36-01-TORTURE-BAN-ACTIVE-FOR-OFFICIAL" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "Asia/Tokyo"; }
        assert r3b_public_official(entity_ref("urn:jp:case:p1")) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(NoTortureProhibition, ACTIVE);
    expect not position(NoTortureProhibition, VIOLATED);
}

test "ART36-02-TORTURE-BY-OFFICIAL-VIOLATED" {

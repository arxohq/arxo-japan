    }
    evaluate positions();
    expect position(ConveneRegularSessionEachYear, UNDETERMINED);
    expect not position(ConveneRegularSessionEachYear, VIOLATED);
}

test "ART52-05-THE-DUTY-IS-PENDING-BEFORE-THE-YEAR" {
    given {

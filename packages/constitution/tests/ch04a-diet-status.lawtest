test "ART52-01-REGULAR-SESSION-DUTY-IS-ACTIVE-IN-THE-YEAR" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "Asia/Tokyo"; }
        assert calendar_year_span(2026, @2026-01-01, @2026-12-31) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(ConveneRegularSessionEachYear, ACTIVE);
}

test "ART52-02-CONVOCATION-IN-THE-YEAR-SATISFIES-THE-DUTY" {
    given {
        context { decision_time @2026-06-01T12:00:00Z; knowledge_time @2026-06-01T12:00:00Z; legal_time @2026-06-01; timezone "Asia/Tokyo"; }
        assert calendar_year_span(2026, @2026-01-01, @2026-12-31) { id "f0"; origin case_input; }
        assert regular_session_convened_in(2026) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(ConveneRegularSessionEachYear, SATISFIED);
}

test "ART52-03-NO-CONVOCATION-BY-THE-END-OF-THE-YEAR-VIOLATES-THE-DUTY" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "Asia/Tokyo"; }
        assert calendar_year_span(2026, @2026-01-01, @2026-12-31) { id "f0"; origin case_input; }
        assert not regular_session_convened_in(2026) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(ConveneRegularSessionEachYear, VIOLATED);
}

test "ART52-04-SILENCE-AFTER-THE-YEAR-IS-NOT-A-VIOLATION" {
    given {
        context { decision_time @2027-01-15T12:00:00Z; knowledge_time @2027-01-15T12:00:00Z; legal_time @2027-01-15; timezone "Asia/Tokyo"; }

// --- Article 4(2): delegation (external: the statute) ---------------------------
relation emperor_delegates_act(o: Organ, a: StateAct) kind empirical {
    label ja official "国事に関する行為を委任する";
    label en unofficial "the Emperor delegates the act";
}
relation delegation_authorized_by_statute(a: StateAct) kind empirical {
    label ja official "法律の定めるところにより";
    label en unofficial "a statute authorizes the delegation (content of the statute is an external input)";
}
relation act_delegated(a: StateAct) kind institutional {
    label ja official "委任された行為";
    label en unofficial "the act has been validly delegated";
}

@source(JP_CONST_ART4_P2)
rule EmperorMayDelegateActs strict {
    label ja official "天皇は、法律の定めるところにより、その国事に関する行為を委任することができる";
    label en unofficial "Article 4(2). The Emperor may delegate his acts as provided by law";
    for o: Organ; for a: StateAct;
    when emperor(o) and state_matter_act(a);
    then power EmperorDelegateAct {
        holder o; over a;
        exercise emperor_delegates_act(o, a);
        valid_when delegation_authorized_by_statute(a);
        effect create(act_delegated(a));
        window [@1947-05-03, infinity);
    };
}

// --- Article 5: regency -------------------------------------------------------
relation regency_established_under_house_law(r: Organ) kind empirical {
    label ja official "皇室典範の定めるところにより摂政を置く";
    label en unofficial "the regency is established under the Imperial House Law (external input)";
}
relation regent_performs_act_in_emperors_name(r: Organ, a: StateAct) kind empirical {
    label ja official "天皇の名でその国事に関する行為を行ふ";
    label en unofficial "the regent performs the act in the name of the Emperor";
}

@source(JP_CONST_ART5_P1, relation = formalizes, coverage = partial, quote = "摂政は、天皇の名でその国事に関する行為を行ふ")
rule RegentActsInEmperorsName strict {
    label ja official "摂政は、天皇の名でその国事に関する行為を行ふ";
    label en unofficial "Article 5, sentence 1. The regent performs the acts in matters of state in the name of the Emperor";
    for r: Organ; for a: StateAct;
    when regency_established_under_house_law(r) and state_matter_act(a);
    then power RegentPerformAct {
        holder r; over a;
        exercise regent_performs_act_in_emperors_name(r, a);
        valid_when (act_enumerated(a) and cabinet_advice_effective(a));
        effect create(act_has_legal_effect(a));
        window [@1947-05-03, infinity);
    };
}

@source(JP_CONST_ART5_P1, relation = formalizes, coverage = partial, quote = "この場合には、前条第一項の規定を準用する")
rule RegentActOutsideListIsUltraVires strict {
    label ja official "この場合には、前条第一項の規定を準用する";
    label en unofficial "Article 5, sentence 2. Article 4(1) applies mutatis mutandis to the regent";
    for r: Organ; for a: StateAct;
    when regency_established_under_house_law(r) and regent_performs_act_in_emperors_name(r, a) and not_known(act_enumerated(a));
    then act_ultra_vires(a);
}

// --- Article 7(3): competing readings on the basis of dissolution -------------
relation no_confidence_resolution_basis(a: StateAct) kind empirical {
    label ja official "内閣不信任の決議（第六十九条）";
    label en unofficial "a resolution of no confidence of Art. 69 preceded the dissolution (producer: stage J6)";
}
relation dissolution_substantively_lawful(a: StateAct) kind institutional {
    label ja official "衆議院の解散の実質的根拠";
    label en unofficial "the dissolution has a substantive basis under the selected reading";
}

@source(JP_CONST_ART7_P1, relation = formalizes, coverage = partial, quote = "衆議院を解散すること")
rule DissolutionByCabinetDiscretionArt7 strict {
    label en unofficial "Reading 'Art. 7 at Cabinet discretion': the Cabinet may advise dissolution at its discretion";
    for a: StateAct; for k: StateActKind;
    when act_kind(a, k) and k == dissolve_house and cabinet_advised_and_approved(a);
    then dissolution_substantively_lawful(a);
}

@source(JP_CONST_ART7_P1, relation = formalizes, coverage = partial, quote = "衆議院を解散すること")
rule DissolutionOnlyAfterNoConfidenceArt69 strict {
    label en unofficial "Reading 'Art. 69 only': dissolution only on the ground of the no-confidence procedure";
    for a: StateAct; for k: StateActKind;
    when act_kind(a, k) and k == dissolve_house and cabinet_advised_and_approved(a) and no_confidence_resolution_basis(a);
    then dissolution_substantively_lawful(a);
}

interpretation Article7DissolutionPractice of JP_CONST_ART7_P1 {
    status disputed;
    include DissolutionByCabinetDiscretionArt7;
    label ja unofficial "七条解散（実務）";
    label en unofficial "Dissolution under Art. 7 at Cabinet discretion (reading argued in the Diet, Dec 1948; not a Government holding)";
}

interpretation Article69OnlyDissolution of JP_CONST_ART7_P1 {
    status disputed;
    include DissolutionOnlyAfterNoConfidenceArt69;
    label ja unofficial "六十九条限定説";
    label en unofficial "Dissolution only under Art. 69 (reading argued in the Diet, Dec 1948; not a Government holding)";
}

// --- Article 8: property of the Imperial House ---------------------------------
relation imperial_house_transfer(t: PropertyTransfer) kind empirical {
    label ja official "皇室への（又は皇室による）財産の譲渡、譲受け、賜与";
    label en unofficial "the transfer or gift is to or from the Imperial House";
}
relation party_to_transfer(p: Person, t: PropertyTransfer) kind empirical {
    label ja official "財産の授受の当事者";
    label en unofficial "the person is a party to the transfer";
}
relation performs_transfer(p: Person, t: PropertyTransfer) kind empirical {
    label ja official "財産を譲り渡し、譲り受け、又は賜与する";
    label en unofficial "the person performs the transfer";
}
relation diet_resolution_basis(t: PropertyTransfer) kind empirical {
    label ja official "国会の議決に基く";
    label en unofficial "the transfer is based on a resolution of the Diet";
}

@source(JP_CONST_ART8_P1)
rule ImperialHousePropertyNeedsDietResolution strict {
    label ja official "皇室に財産を譲り渡し、又は皇室が、財産を譲り受け、若しくは賜与することは、国会の議決に基かなければならない";
    label en unofficial "Article 8. Transfers of property to or from the Imperial House are forbidden without a resolution of the Diet";
    for p: Person; for t: PropertyTransfer;
    when imperial_house_transfer(t) and party_to_transfer(p, t) and not_known(diet_resolution_basis(t));
    then prohibition ImperialHouseTransferWithoutDietResolution {
        bearer p;
        action performs_transfer(p, t);
        window [@1947-05-03, infinity);
    };
}
